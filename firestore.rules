rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() in [
          'weldonrs@gmail.com',
          '2283701@progcir.app',
          '2283701@progcir.com',
          '2283701@gmail.com'
        ] || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Regras Específicas
    
    match /users/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(id);
    }

    match /personal_data/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isOwner(id) || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /regional_convention_invitations/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.collaboratorId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /circuit_assembly_supt_invitations/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.collaboratorId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /circuit_assembly_branch_invitations/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.collaboratorId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /circuit_assembly_supt_speakers/{id} {
      allow read, write: if isSignedIn();
    }

    match /circuit_assembly_branch_speakers/{id} {
      allow read, write: if isSignedIn();
    }

    match /congregations/{id} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /substitutes/{id} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /itineraries/{id} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /pioneer_school_info/{id} {
      allow read, write: if isSignedIn();
    }

    match /document_templates/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && request.resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /role_change_requests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /pioneer_school_invitations/{id} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.collaboratorId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /config/app_settings {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /weekly_expenses/{id} {
      allow read, write: if isSignedIn() && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid) || 
        (request.resource.data.userId == request.auth.uid)
      );
    }
    
    match /timer_broadcasts/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /shared_report_profiles/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /service_reports/{reportId} {
      allow read, write: if true;
    }

    match /assembly_programs/{id} {
      allow read, write: if true;
    }

    match /visit_schedules/{id} {
      allow read, write: if isSignedIn();
      // Leitura e atualização com base no link compartilhado
      allow read: if true;
      allow update: if request.resource.data.shareToken == resource.data.shareToken;
    }


    // Microsoft OAuth - Permissions for the connection process
    match /microsoft_connections/{id} {
      allow read: if isSignedIn() && (id == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (id == request.auth.uid || isAdmin());
    }

    match /email_drafts/{id} {
      allow read, write: if isSignedIn() && (
        isAdmin() || 
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid)
      );
    }

    match /email_attachments/{id} {
      allow read, write: if isSignedIn();
    }

    match /oauth_attempts/{id} {
      // Allow creation of attempts linked to the current user
      allow read, write: if isSignedIn();
    }

    // Fallback para outras coleções menores
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
