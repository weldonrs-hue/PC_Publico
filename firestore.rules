rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares
    function isSignedIn() {
      return request.auth != null;
    }

    // Regras para todas as coleções do sistema
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }
    
    match /personal_data/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /congregations/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /substitutes/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /itineraries/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /activity_analysis/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /s303_reports/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /service_reports/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /pioneer_school_students/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /pioneer_school_workshops/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /regional_convention_speakers/{id} {
      allow read, write: if isSignedIn();
    }

    match /pioneer_school_invitations/{id} {
      allow read, write: if isSignedIn();
    }

    match /pioneer_school_info/{id} {
      allow read, write: if isSignedIn();
    }

    match /role_change_requests/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.token.email == 'weldonrs@gmail.com' || 
        request.auth.token.email == '2283701@progcir.app' ||
        request.auth.token.email == '2283701@progcir.com'
      );
      allow delete: if false;
    }

    match /config/app_settings {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.token.email == 'weldonrs@gmail.com' || 
        request.auth.token.email == '2283701@progcir.app' ||
        request.auth.token.email == '2283701@progcir.com'
      );
    }

    // Regra global de segurança para o teste
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
