rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - role: string ("admin" | "user")
//   - numeroPessoal: string (optional, for migration)
//
// Collection: personal_data
// Document ID: {dataId} (UID or numeroPessoal)
// Fields:
//   - userId: string (UID)
//   - name: string
//   - email: string
//   - [other personal fields]
//
// Collection: congregations, substitutes, itineraries, activity_analysis, s303_reports
// Document ID: {id}
// Fields:
//   - userId: string (UID)
//   - [collection specific fields]
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isEmailAdmin() {
      return signedIn() && 
             (
               (request.auth.token.get('email', '') == "weldonrs@gmail.com" && request.auth.token.get('email_verified', false) == true) ||
               request.auth.token.get('email', '') == "2283701@progcir.app" ||
               request.auth.token.get('email', '') == "2283701@progcir.com"
             );
    }

    function isRoleAdmin() {
      return signedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    function isAdmin() {
      return isEmailAdmin() || isRoleAdmin();
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return signedIn() && (
        (resource != null && (resource.data.get('userId', '') == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.get('userId', '') == request.auth.uid))
      );
    }

    function isEmailPrefix(prefix) {
      return signedIn() && 
             prefix != null && 
             prefix != "" && 
             request.auth.token.get('email', '').lower().matches("^" + prefix.lower() + "@.*");
    }

    function isOwnerByEmail() {
      return signedIn() && (
        resource.data.get('emailPessoal', '') == request.auth.token.get('email', '') ||
        resource.data.get('emailJwpub', '') == request.auth.token.get('email', '') ||
        request.auth.token.get('email', '').lower().matches("^" + resource.data.get('numeroPessoal', 'NON_EXISTENT').lower() + "@.*")
      );
    }

    // Global admin access (Email-based only to avoid recursion)
    match /{document=**} {
      allow read, write: if isEmailAdmin();
    }

    // Rules for users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isEmailAdmin();
    }

    // Rules for personal_data
    match /personal_data/{dataId} {
      // Allow read if document ID is UID, or if user is admin, or if document has matching userId field, or matches email prefix
      allow read: if signedIn() && (
        isAdmin() || 
        request.auth.uid == dataId || 
        isEmailPrefix(dataId) ||
        (resource != null && (
          resource.data.get('userId', '') == request.auth.uid || 
          (request.auth.token.get('email', '') != '' && (
            resource.data.get('emailPessoal', '') == request.auth.token.get('email', '') ||
            resource.data.get('emailJwpub', '') == request.auth.token.get('email', '') ||
            request.auth.token.get('email', '').lower().matches("^" + resource.data.get('numeroPessoal', 'NON_EXISTENT').lower() + "@.*")
          ))
        ))
      );
      
      // Allow write if owner or admin
      allow write: if signedIn() && (
        isAdmin() || 
        request.auth.uid == dataId || 
        isEmailPrefix(dataId) ||
        (resource != null && (resource.data.get('userId', '') == request.auth.uid || isOwnerByEmail())) ||
        (request.resource != null && (request.resource.data.get('userId', '') == request.auth.uid || isOwnerByEmail()))
      );
    }

    // Rules for other collections
    match /congregations/{id} {
      allow read: if signedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow write: if signedIn() && (
        (resource != null && resource.data.get('userId', '') == request.auth.uid) ||
        (request.resource != null && request.resource.data.get('userId', '') == request.auth.uid) ||
        isAdmin()
      );
    }

    match /substitutes/{id} {
      allow read: if signedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow write: if signedIn() && (
        (resource != null && resource.data.get('userId', '') == request.auth.uid) ||
        (request.resource != null && request.resource.data.get('userId', '') == request.auth.uid) ||
        isAdmin()
      );
    }

    match /itineraries/{id} {
      allow read: if signedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow write: if signedIn() && (
        (resource != null && resource.data.get('userId', '') == request.auth.uid) ||
        (request.resource != null && request.resource.data.get('userId', '') == request.auth.uid) ||
        isAdmin()
      );
    }

    match /activity_analysis/{id} {
      allow read: if signedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid || id.startsWith(request.auth.uid + "_") || isAdmin());
      allow write: if signedIn() && (
        (resource != null && resource.data.get('userId', '') == request.auth.uid) ||
        (request.resource != null && request.resource.data.get('userId', '') == request.auth.uid) ||
        id.startsWith(request.auth.uid + "_") ||
        isAdmin()
      );
    }

    match /s303_reports/{id} {
      allow read: if signedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid || id.startsWith(request.auth.uid + "_") || isAdmin());
      allow write: if signedIn() && (
        (resource != null && resource.data.get('userId', '') == request.auth.uid) ||
        (request.resource != null && request.resource.data.get('userId', '') == request.auth.uid) ||
        id.startsWith(request.auth.uid + "_") ||
        isAdmin()
      );
    }

    match /pioneer_school_students/{id} {
      allow read: if signedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow write: if signedIn() && (
        (resource != null && resource.data.get('userId', '') == request.auth.uid) ||
        (request.resource != null && request.resource.data.get('userId', '') == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}

